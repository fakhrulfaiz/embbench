# HuggingFace cache. Native Linux uses ~/.cache/huggingface.
# On WSL, set these to /mnt/c/ml-cache/huggingface (and hub/datasets) so Hub
# files land on the Windows drive, not ext4.
HF_HOME=/home/user/.cache/huggingface
HF_HUB_CACHE=/home/user/.cache/huggingface/hub
HF_DATASETS_CACHE=/home/user/.cache/huggingface/datasets
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HF_HUB_ENABLE_HF_TRANSFER=0

# MTEB result cache stays on WSL ext4 (small, written constantly).
MTEB_CACHE=results/mteb-cache

# Qdrant (index serving-path metrics only; never used for nDCG/Recall scoring).
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# OpenAI-compatible embeddings server (vLLM pooling). Used only when a model
# has loader: openai_api. Per-model endpoint_url in models.yaml overrides this.
EMBBENCH_EMBEDDINGS_URL=http://127.0.0.1:8001
EMBBENCH_EMBEDDINGS_API_KEY=

# Job output root (ext4).
EMBBENCH_RESULTS_DIR=results
EMBBENCH_DATA_DIR=data
EMBBENCH_CONFIGS_DIR=configs

# Postgres (generation). Copy real DSN into .env; do not commit secrets.
DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/embbench

# Chat vLLM (CUDA 13.0). LLM_PATH is the model folder (config.json inside).
LLM_PATH=/usr/local/models/Qwen2.5-14B-Instruct-AWQ
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5-14b-instruct
LLM_TIMEOUT_S=120
LLM_PORT=8000
LLM_GPU_NO=0
LLM_GPU_MEMORY=0.75
LLM_MAX_SEQ_LEN=4096
LLM_MAX_REQ=5

CHUNKER_PROFILE=bce_500_50_min100
EXPORT_DIR=/home/user/embbench/data

# launch.sh defaults. GEN_COUNT can be a number or all.
GEN_COUNT=200
GEN_LANGUAGE=en
GEN_CONCURRENCY=4
RETRIEVAL_NAME=sop-handbook-v1
STS_NAME=sop-sts-v1
EMBEDDING_MODEL=bce-embedding-base_v1
DASHBOARD_PORT=8501

# Option 3. One id, comma list, or all (sequential: one GPU). Unset → EMBEDDING_MODEL.
# BENCH_MODELS=all
# Local folders under data/retrieval and data/sts: names, comma list, or all.
# Unset → RETRIEVAL_NAME (also matches <name>-en/zh/ms).
# BENCH_TASKS=all

# Pooling vLLM. Chat stays on LLM_PORT; launch.sh never runs both.
EMBED_PORT=8001
EMBED_PATH=/usr/local/models/bce-embedding-base_v1
EMBED_SERVE=/models
EMBED_NAME=maidalun1020/bce-embedding-base_v1
EMBED_MAX_LEN=512
EMBED_GPU_MEMORY=0.6
EMBED_MAX_REQ=8
EMBED_HF_CACHE=/home/user/.cache/huggingface
EMBED_DTYPE=float16
EMBED_CONVERT=embed
EMBED_POOLER_CONFIG='{"pooling_type":"CLS"}'
EMBED_HF_OVERRIDES=
EMBED_ENFORCE_EAGER=0
# launch.sh sets both per model. Causal embedders (Harrier, Qwen3) need
# EMBED_PREFIX_CACHE=0 and a budget that fits one full prefill, or long document
# batches wedge the engine.
EMBED_PREFIX_CACHE=1
EMBED_MAX_BATCHED_TOKENS=
